{
  "manifest_version": 3,
  "name": "UrreAI",
  "short_name": "UrreAI",
  "version": "0.2.0",
  "description": "Lo que lees en rotación, a UrreAI: pregúntalo al chat de evidencia, guárdalo como flashcard o captura un laboratorio para tu paciente.",
  "author": "UrreAI",
  "homepage_url": "https://urreai.com",
  "minimum_chrome_version": "121",

  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "scripting",
    "clipboardWrite"
  ],

  "host_permissions": [
    "https://app.urreai.com/*",
    "http://localhost:3000/*"
  ],

  "omnibox": {
    "keyword": "urreai"
  },

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Abrir UrreAI"
    },
    "capture-lab": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Capturar laboratorios de una región de la pantalla"
    },
    "capture-vital": {
      "suggested_key": {
        "default": "Ctrl+Shift+I",
        "mac": "Command+Shift+I"
      },
      "description": "Capturar signos vitales de una región de la pantalla"
    },
    "capture-imaging": {
      "suggested_key": {
        "default": "Ctrl+Shift+R",
        "mac": "Command+Shift+R"
      },
      "description": "Capturar un informe de imagen de una región de la pantalla"
    }
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "UrreAI",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "background": {
    "service_worker": "background.js",
    "scripts": ["lib/enlaces.js", "background.js"]
  },

  "content_scripts": [
    {
      "matches": [
        "https://app.urreai.com/*",
        "http://localhost:3000/*"
      ],
      "js": ["content/vincular.js"],
      "run_at": "document_idle"
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "urreai@urreai.com",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["websiteContent", "healthInfo"]
      }
    }
  }
}

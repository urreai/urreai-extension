{
  "manifest_version": 3,
  "name": "UrreAI",
  "short_name": "UrreAI",
  "version": "0.3.0",
  "description": "Haz flashcards sin salir de la página, busca entre 185 calculadoras y pregúntale al chat de evidencia de UrreAI.",
  "author": "UrreAI",
  "homepage_url": "https://urreai.com",
  "minimum_chrome_version": "121",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "scripting",
    "clipboardWrite",
    "sidePanel"
  ],
  "host_permissions": [
    "https://app.urreai.com/*",
    "http://localhost:3000/*"
  ],
  "omnibox": {
    "keyword": "urreai"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+U",
        "mac": "MacCtrl+Shift+U"
      },
      "description": "Abrir UrreAI"
    },
    "crear-flashcard": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "MacCtrl+Shift+F"
      },
      "description": "Crear una flashcard con lo seleccionado"
    },
    "preguntar": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "MacCtrl+Shift+E"
      },
      "description": "Preguntar lo seleccionado al chat de evidencia"
    },
    "capture-lab": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "MacCtrl+Shift+L"
      },
      "description": "Capturar laboratorios de una región de la pantalla"
    },
    "capture-vital": {
      "description": "Capturar signos vitales de una región de la pantalla"
    },
    "capture-imaging": {
      "description": "Capturar un informe de imagen de una región de la pantalla"
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "UrreAI",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "sidebar_action": {
    "default_panel": "popup/popup.html",
    "default_title": "UrreAI",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "open_at_install": false
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "lib/enlaces.js",
      "lib/cliente.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.urreai.com/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "content/vincular.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "urreai@urreai.com",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "healthInfo"
        ]
      }
    }
  }
}
